{
  "name": "fractui",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn-style component library built on Base UI",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean",
    "check": "pnpm lint && pnpm type-check && pnpm format:check",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-plugin-react": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
